{
  "name": "food-delivery-polyglot-backend",
  "version": "1.0.0",
  "description": "Node.js Express backend demonstrating Polyglot Persistence with PostgreSQL (Prisma), MongoDB (Mongoose), and Redis",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "polyglot-persistence",
    "express",
    "prisma",
    "postgresql",
    "mongodb",
    "mongoose",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.12.0",
    "morgan": "^1.10.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
